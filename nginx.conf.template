# ${PORT} açılışta envsubst ile doldurulur; nginx değişkenlerine ($uri) dokunulmaz.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml;

    # Statik varlıklar: uzun süreli önbellek (Vite hash'lenmiş dosya adları kullanır)
    # `^~`: aşağıdaki uzantı regex'i /assets/ altındaki .svg/.png dosyalarını ezmesin.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:svg|png|ico|webmanifest|xml|txt)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
