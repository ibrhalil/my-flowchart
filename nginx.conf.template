# nginx yapılandırması şablonu: Statik SPA hizmeti
# ${PORT}, konteyner açılışında envsubst ile PORT ortam değişkeninden doldurulur
# (varsayılan: 8765). nginx'in kendi $uri değişkenine dokunulmaz.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # gzip sıkıştırması (mermaid JS paketleri büyük)
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml;

    # Statik varlıklar: uzun süreli önbellek (Vite hash'lenmiş dosya adları kullanır)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Diğer statik dosyalar (favicon, logolar)
    location ~* \.(?:svg|png|ico|webmanifest|xml|txt)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # SPA yönlendirmesi: bilinmeyen tüm yollar index.html'e düşer
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html asla önbelleğenmesin (yeni sürümler hemen görünsün)
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
